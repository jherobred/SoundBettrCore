{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundBettrCore",
  "version": "0.2.0",
  "identifier": "com.jhems.soundbettrcore",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SoundBettrCore",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/kokoro/": "resources/kokoro/",
      "resources/autoeq/": "resources/autoeq/",
      "resources/hrir/": "resources/hrir/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "SoundBettrCore"
      }
    }
  }
}
